# Centralized LLM Configuration (Azure OpenAI Responses API)
LLM_ENDPOINT=https://infrastructuremonitoringagent.openai.azure.com/openai/responses?api-version=2025-04-01-preview
AZURE_OPENAI_ENDPOINT=https://infrastructuremonitoringagent.openai.azure.com/openai/responses?api-version=2025-04-01-preview
LLM_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
MODEL_NAME=5.6 luna

# Fallback Google GenAI configuration
GOOGLE_API_KEY=replace_with_your_google_api_key


# Optional BigQuery configuration
GOOGLE_CLOUD_PROJECT=replace_with_your_gcp_project
BQ_LOCATION=US
BQ_RESULTS_DATASET=bq_support_agent
BQ_RESULTS_TABLE=incident_results
BQ_RAW_RESULTS_TABLE=incident_raw_responses

# Optional telemetry source
METRICS_API_BASE_URL=http://localhost:8080
DATA_SOURCE=vm
MOCK_METRICS_FILE=mock_data/windows_services_metrics.json

# Optional LiteLLM / OpenCode configuration
LITELLM_API_KEY=replace_with_your_litellm_api_key
LITELLM_BASE_URL=https://your-litellm-host.example.com

# Email alerts
DEFAULT_ALERT_EMAIL=alerts@example.com
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=system-monitor@example.com

# Target VM SSH Configuration (for Human-in-the-Loop Remediation Execution)
VM_HOST=20.15.164.79
VM_SSH_PORT=22
VM_USER=azure-cpu-user
VM_KEY_PATH=config/vm_key.pem
# VM_PASSWORD=your_vm_password
